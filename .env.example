# Configuration of one Instance. Copy to .env, fill it in, then run scripts/init.sh.
# .env is ignored by git: it holds your secrets and never leaves this machine.

# ---------------------------------------------------------------------------
# Profiles
# ---------------------------------------------------------------------------
# Optional groups of services on top of the Core, comma separated (e.g. "vo,proxy").
# Leave empty to run only the Core.
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# App data: every service's config and databases, one folder per service.
# Keep it outside this repo and back it up.
APPDATA_ROOT=/opt/media-stack/appdata

# Media root, mounted as /data in the containers. Downloads and the library must be
# on the same filesystem so Radarr/Sonarr import with hardlinks instead of copies:
#   DATA_ROOT/torrents/{movies,tv}   qBittorrent downloads here
#   DATA_ROOT/media/{movies,tv}      the library Jellyfin serves
DATA_ROOT=/srv/data

# ---------------------------------------------------------------------------
# File owner and time zone
# ---------------------------------------------------------------------------
# Owner of the files the containers write. Find yours with `id -u` and `id -g`.
PUID=1000
PGID=1000
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Docker network shared by the stacks (created by scripts/init.sh). Empty = media-network.
MEDIA_NETWORK=media-network

# ---------------------------------------------------------------------------
# VPN gateway (gluetun)
# ---------------------------------------------------------------------------
# All torrent and indexer traffic goes through this VPN. Any provider gluetun
# supports works: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Examples: protonvpn, mullvad, airvpn, private internet access, surfshark, nordvpn.
VPN_SERVICE_PROVIDER=
# wireguard or openvpn. Fill only the credentials for the type you pick.
VPN_TYPE=wireguard

# WireGuard: the private key from your provider's WireGuard config file.
WIREGUARD_PRIVATE_KEY=
# Some providers (e.g. mullvad, surfshark) also need the interface address, e.g. 10.64.222.21/32.
WIREGUARD_ADDRESSES=

# OpenVPN: your provider's OpenVPN/service credentials (often not your account login).
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional: comma-separated server countries, e.g. "Netherlands,Switzerland".
VPN_SERVER_COUNTRIES=

# Optional: LAN subnets the apps behind the VPN may reach (e.g. 192.168.1.0/24).
VPN_OUTBOUND_SUBNETS=

# Optional port forwarding (better seeding). Only some providers support it
# (e.g. protonvpn, private internet access). "on" or "off". gluetun hands the port
# to qBittorrent, which needs "Bypass authentication for clients on localhost"
# turned on (Options > WebUI).
VPN_PORT_FORWARDING=off
# Leave empty to use VPN_SERVICE_PROVIDER.
VPN_PORT_FORWARDING_PROVIDER=
