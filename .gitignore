# Whitelist: ignore everything, then allow only what belongs to the Template.
# Anything specific to an Instance (.env, app data, databases, logs) stays out (ADR 0001).
*
!*/

!/.gitignore
!/.gitleaks.toml
!/.env.example
!/compose.yaml
!/compose.gpu.yaml
!/LICENSE
!/README*.md
!/CONTEXT.md
!/AGENTS.md
!/renovate.json

!/stacks/*/compose.yaml
!/stacks/*/README.md
!/stacks/*/Dockerfile
!/stacks/*/*.sh
# Services built locally: one folder per image inside its stack.
!/stacks/*/*/Dockerfile
!/stacks/*/*/*.py
!/stacks/transcode/plugins/*.js
# The Worker: its own compose project, run on the Worker, not on the Instance.
!/worker/compose.yaml
!/worker/*.example
!/scripts/*.sh
!/scripts/lib/*.sh
!/scripts/env_contract.py
!/env/catalog.json
!/env/*.template
!/tests/*.sh
!/docs/**/*.md
!/examples/**/*.example
!/examples/**/*.md
!/.githooks/*
!/.github/**/*.yml
!/.github/**/*.yaml
!/.github/**/*.md
