# Generated by scripts/env_contract.py from this template and env/catalog.json.
# Configuration of one Instance. Run scripts/setup.sh to answer questions and get a .env,
# or copy this file to .env, fill it in and run scripts/init.sh.
# .env is ignored by git: it holds your secrets and never leaves this machine.

# ---------------------------------------------------------------------------
# Profiles
# ---------------------------------------------------------------------------
# Optional groups of services on top of the Core, comma separated (e.g. "vo,proxy").
# Leave empty to run only the Core. What each one adds: docs/profiles.md.
#   backup      nightly encrypted copy of the App data (docs/backup.md)
#   vo          second Radarr/Sonarr for an original-version library
#   jackett     Jackett, for indexers Prowlarr lacks
#   seeding     qui and cleanuparr, around qBittorrent
#   cleanup     Maintainerr, removes library items by rules
#   dashboard   Homarr and Dockge
#   monitoring  Beszel and What's Up Docker
#   proxy       Nginx Proxy Manager (publish Jellyfin and Seerr; docs/security.md)
#   remote      Tailscale
#   extras      issue-automator, mousehole, Tor proxy, File Browser
#   transcode   Tdarr server, for a Worker to transcode with (docs/transcode.md)
COMPOSE_PROFILES=@

# Hardware transcoding with this host's GPU (/dev/dri) for Jellyfin and Tdarr: uncomment,
# and set RENDER_GID to the host's render group (`getent group render | cut -d: -f3`).
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
RENDER_GID=@

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# App data: every service's config and databases, one folder per service.
# Keep it outside this repo and back it up.
APPDATA_ROOT=@

# Media root, mounted as /data in the containers. Downloads and the library must be
# on the same filesystem so Radarr/Sonarr import with hardlinks instead of copies:
#   DATA_ROOT/torrents/{movies,tv}   qBittorrent downloads here
#   DATA_ROOT/media/{movies,tv}      the library Jellyfin serves
DATA_ROOT=@

# ---------------------------------------------------------------------------
# File owner and time zone
# ---------------------------------------------------------------------------
# Owner of the files the containers write. Find yours with `id -u` and `id -g`.
PUID=@
PGID=@
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=@

# Docker network shared by the stacks (created by scripts/init.sh). Empty = media-network.
MEDIA_NETWORK=@

# ---------------------------------------------------------------------------
# VPN gateway (gluetun)
# ---------------------------------------------------------------------------
# All torrent and indexer traffic goes through this VPN. Any provider gluetun
# supports works: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Examples: protonvpn, mullvad, airvpn, private internet access, surfshark, nordvpn.
VPN_SERVICE_PROVIDER=@
# wireguard or openvpn. Fill only the credentials for the type you pick.
VPN_TYPE=@

# WireGuard: the private key from your provider's WireGuard config file.
WIREGUARD_PRIVATE_KEY=@
# Some providers (airvpn, fastestvpn, ivpn, mullvad, surfshark, windscribe) also need the interface address, e.g. 10.64.222.21/32.
WIREGUARD_ADDRESSES=@
# Only airvpn needs a preshared key as well.
WIREGUARD_PRESHARED_KEY=@

# OpenVPN: your provider's OpenVPN/service credentials (often not your account login).
OPENVPN_USER=@
OPENVPN_PASSWORD=@

# Optional: comma-separated server countries, e.g. "Netherlands,Switzerland".
VPN_SERVER_COUNTRIES=@

# Optional: LAN subnets the apps behind the VPN may reach (e.g. 192.168.1.0/24).
VPN_OUTBOUND_SUBNETS=@

# Optional port forwarding (better seeding). Only some providers support it
# (e.g. protonvpn, private internet access). "on" or "off". gluetun hands the port
# to qBittorrent, which needs "Bypass authentication for clients on localhost"
# turned on (Options > WebUI).
VPN_PORT_FORWARDING=@
# Leave empty to use VPN_SERVICE_PROVIDER.
VPN_PORT_FORWARDING_PROVIDER=@

# ---------------------------------------------------------------------------
# App connections (the Wiring: stacks/wire, docs/wiring.md)
# ---------------------------------------------------------------------------
# On every `docker compose up`, the wire container connects the apps to each other
# (download client, indexers, Seerr, Bazarr, quality profile). It only adds what is
# missing and never changes what you configured.
#
# API keys and passwords the apps start with. scripts/setup.sh generates them for apps
# that have no App data yet; before their first start any 32-character hex string
# works (`openssl rand -hex 16`). Apps already set up keep their own key: the Wiring
# reads it from their App data, so these can stay empty.
RADARR_API_KEY=@
SONARR_API_KEY=@
PROWLARR_API_KEY=@
BAZARR_API_KEY=@
SEERR_API_KEY=@
# Only with the "vo" Profile.
RADARR_VO_API_KEY=@
SONARR_VO_API_KEY=@
# qBittorrent's web UI login, which Radarr and Sonarr use too.
QBITTORRENT_USER=@
QBITTORRENT_PASSWORD=@
# Jellyfin's admin, created on its first start. It is also your Seerr login.
JELLYFIN_ADMIN_USER=@
JELLYFIN_ADMIN_PASSWORD=@
# Optional Jellyfin customizations (docs/jellyfin-customizations.md), on or off. The
# Wiring installs them with the admin above and restarts Jellyfin once to load plugins.
#   JELLYFIN_ABYSS           the Abyss theme, dark theme, home order and Spotlight
JELLYFIN_ABYSS=@
# Qualities to download, comma separated, from: Remux-2160p, Bluray-2160p, WEB 2160p,
# HDTV-2160p, Remux-1080p, Bluray-1080p, WEB 1080p, HDTV-1080p, Bluray-720p, WEB 720p,
# HDTV-720p, Bluray-576p, Bluray-480p, WEB 480p, DVD, SDTV, Raw-HD, BR-DISK. They go into
# a "Media Stack" profile in Radarr and Sonarr, scored with the TRaSH Guides. Empty =
# no quality profile is created.
QUALITIES=@

# ---------------------------------------------------------------------------
# Profile "backup": nightly encrypted copy of the App data (docs/backup.md)
# ---------------------------------------------------------------------------
# Add "backup" to COMPOSE_PROFILES to turn it on. Keep RESTIC_PASSWORD and
# APPDATA_ROOT/backup/rclone.conf in your password manager: without them the
# backup cannot be read.
RESTIC_PASSWORD=@
# Where the encrypted repository lives: an rclone remote and folder. "gdrive" must
# match the remote name in rclone.conf.
RESTIC_REPOSITORY=@
# Folder to back up. Empty = APPDATA_ROOT. Point it at your old layout if your
# app data lives somewhere else.
BACKUP_SOURCE=@
# Extra comma-separated patterns to leave out, on top of caches, artwork, logs and
# the apps' own backups. A name ("cache") matches anywhere; a path ("jellyfin/web")
# is relative to BACKUP_SOURCE.
BACKUP_EXCLUDE=@
# When to run (cron, in TZ) and how many snapshots to keep.
BACKUP_SCHEDULE=@
BACKUP_KEEP_DAILY=@
BACKUP_KEEP_WEEKLY=@
BACKUP_KEEP_MONTHLY=@
# Name of this Instance in the repository; restores pick snapshots by it.
BACKUP_HOST=@
# Optional Telegram alert when a backup fails (also used by the extras Profile's
# issue-automator): bot token from @BotFather and the chat that receives it.
TELEGRAM_BOT_TOKEN=@
TELEGRAM_CHAT_ID=@

# ---------------------------------------------------------------------------
# Profile "dashboard": Homarr and Dockge
# ---------------------------------------------------------------------------
# Homarr encrypts its secrets with this key. Generate it once with `openssl rand -hex 32`
# and keep it: without it Homarr cannot read its own database.
HOMARR_SECRET_KEY=@
# Folder with the compose stacks Dockge manages. Point it at the folder that holds this
# clone to see it as a stack.
DOCKGE_STACKS_DIR=@

# ---------------------------------------------------------------------------
# Profile "monitoring": Beszel and What's Up Docker
# ---------------------------------------------------------------------------
# Address you open Beszel at, e.g. http://192.168.1.10:8090.
BESZEL_APP_URL=@
# From Beszel's "Add system" dialog, after the hub's first start: the public key and the
# token. Until then the agent keeps restarting.
BESZEL_AGENT_KEY=@
BESZEL_AGENT_TOKEN=@
# What's Up Docker's login. Its update alerts go to TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID.
WUD_ADMIN_USER=@
WUD_ADMIN_PASSWORD=@
# When to check for new images (cron, in TZ).
WUD_CRON=@

# ---------------------------------------------------------------------------
# Profile "remote": Tailscale
# ---------------------------------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys. Only needed the first
# time: once APPDATA_ROOT/tailscale holds the node's state, it is ignored.
TAILSCALE_AUTHKEY=@
# Name of this machine in your tailnet. Keep the old name when moving an existing node.
TAILSCALE_HOSTNAME=@
# Optional: your LAN subnet, to reach the rest of the LAN through this node (subnet
# router), e.g. 192.168.1.0/24. Check yours with `ip route`: it must be the subnet your
# LAN really uses. Approve it in the admin console whenever it changes.
TAILSCALE_ROUTES=@

# ---------------------------------------------------------------------------
# Profile "proxy": Nginx Proxy Manager
# ---------------------------------------------------------------------------
# Optional: the public domain Jellyfin and Seerr are reached at. Only scripts/setup.sh
# reads it, to print the next steps; proxy hosts are created in Nginx Proxy Manager (port 81).
PROXY_DOMAIN=@

# ---------------------------------------------------------------------------
# Profile "extras": issue-automator, mousehole, Tor proxy, File Browser
# ---------------------------------------------------------------------------
# issue-automator uses the API keys of the "App connections" section. The URLs default
# to the services on the media network; to change one, add SEERR_URL, RADARR_URL,
# SONARR_URL, BAZARR_URL, RADARR_VO_URL or SONARR_VO_URL. Subtitle issues go to Bazarr
# only when BAZARR_API_KEY is set.
SEERR_URL=@
RADARR_URL=@
SONARR_URL=@
BAZARR_URL=@
RADARR_VO_URL=@
SONARR_VO_URL=@

# Optional, with the "vo" Profile: the id Seerr gives each VO manager (Seerr > Settings >
# Services: the first server is 0, the next 1...). Issues on media from that server go
# to the VO manager.
SEERR_RADARR_VO_SERVER_ID=@
SEERR_SONARR_VO_SERVER_ID=@
# Telegram alerts use TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID from the backup section.

# mousehole: password for its web UI, and the address you open it at (host:port, comma
# separated), e.g. 192.168.1.10:5010 or your Tailscale IP.
MOUSEHOLE_AUTH_PASSWORD=@
MOUSEHOLE_ALLOWED_HOSTS=@
