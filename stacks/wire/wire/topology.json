{
  "services": [
    {"key": "gluetun", "namespace": "gluetun", "expect": "healthy"},
    {"key": "qbittorrent", "namespace": "gluetun", "expect": "healthy", "port": 8080,
     "publication": {"service": "gluetun", "port": 8080}, "port_env": "WEBUI_PORT",
     "health_path": "", "data_mount": "/data/torrents"},
    {"key": "prowlarr", "namespace": "gluetun", "expect": "healthy", "port": 9696,
     "publication": {"service": "gluetun", "port": 9696}, "health_path": "/ping"},
    {"key": "flaresolverr", "namespace": "gluetun", "expect": "healthy", "port": 8191,
     "health_path": "/health"},
    {"key": "radarr", "namespace": "gluetun", "expect": "healthy", "port": 7878,
     "publication": {"service": "gluetun", "port": 7878}, "health_path": "/ping", "data_mount": "/data",
     "manager": {"kind": "radarr", "name": "Radarr", "root": "/data/media/movies", "category": "movies"}},
    {"key": "sonarr", "namespace": "gluetun", "expect": "healthy", "port": 8989,
     "publication": {"service": "gluetun", "port": 8989}, "health_path": "/ping", "data_mount": "/data",
     "manager": {"kind": "sonarr", "name": "Sonarr", "root": "/data/media/tv", "category": "tv"}},
    {"key": "bazarr", "namespace": "gluetun", "expect": "healthy", "port": 6767,
     "publication": {"service": "gluetun", "port": 6767}, "health_path": "", "data_mount": "/data/media"},
    {"key": "jellyfin", "namespace": "jellyfin", "expect": "healthy", "port": 8096,
     "publication": {"service": "jellyfin", "port": 8096}, "data_mount": "/data/media"},
    {"key": "seerr", "namespace": "seerr", "expect": "healthy", "port": 5055,
     "publication": {"service": "seerr", "port": 5055}, "port_env": "PORT", "health_path": "/api/v1/status"},
    {"key": "wire-seed", "namespace": "none", "expect": "completed", "data_mount": "/data"},
    {"key": "wire", "namespace": "wire", "expect": "completed"},
    {"key": "radarr-vo", "profile": "vo", "namespace": "gluetun", "expect": "healthy", "port": 7879,
     "publication": {"service": "gluetun", "port": 7879}, "port_env": "RADARR__SERVER__PORT",
     "health_path": "/ping", "data_mount": "/data",
     "manager": {"kind": "radarr", "name": "Radarr VO", "root": "/data/media/movies-vo", "category": "movies-vo"}},
    {"key": "sonarr-vo", "profile": "vo", "namespace": "gluetun", "expect": "healthy", "port": 8990,
     "publication": {"service": "gluetun", "port": 8990}, "port_env": "SONARR__SERVER__PORT",
     "health_path": "/ping", "data_mount": "/data",
     "manager": {"kind": "sonarr", "name": "Sonarr VO", "root": "/data/media/tv-vo", "category": "tv-vo"}}
  ]
}
